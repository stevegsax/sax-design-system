{
  "$description": "APCA Readability Criterion gates, checked for base plus every situation x mode resolver. minLc thresholds follow ARC Bronze: 75 body text, 60 large/heading and UI labels, 45 non-text indicators. Disabled-state pairings are deliberately absent: disabled controls are exempt per decisions/2026-07-19-disabled-state.md.",
  "pairs": [
    { "foreground": "color.text.body", "background": "color.background.page", "minLc": 75, "usage": "body text on page" },
    { "foreground": "color.text.body", "background": "color.background.surface", "minLc": 75, "usage": "body text on surface" },
    { "foreground": "color.text.heading", "background": "color.background.page", "minLc": 60, "usage": "headings on page" },
    { "foreground": "color.text.muted", "background": "color.background.surface", "minLc": 60, "usage": "muted text on surface" },
    { "foreground": "color.text.link", "background": "color.background.page", "minLc": 60, "usage": "links on page" },
    { "foreground": "button.primary.text", "background": "button.primary.background", "minLc": 60, "usage": "primary button label" },
    { "foreground": "button.secondary.text", "background": "button.secondary.background", "minLc": 60, "usage": "secondary button label" },
    { "foreground": "input.text", "background": "input.background", "minLc": 75, "usage": "input value text" },
    { "foreground": "input.placeholder", "background": "input.background", "minLc": 60, "usage": "input placeholder" },
    { "foreground": "color.border.focus", "background": "color.background.page", "minLc": 45, "usage": "focus indicator (non-text)" },
    { "foreground": "color.status.success.text", "background": "color.background.page", "minLc": 75, "usage": "inline success text" },
    { "foreground": "color.status.success.text", "background": "color.status.success.background", "minLc": 60, "usage": "success alert text" },
    { "foreground": "color.status.warning.text", "background": "color.background.page", "minLc": 75, "usage": "inline warning text" },
    { "foreground": "color.status.warning.text", "background": "color.status.warning.background", "minLc": 60, "usage": "warning alert text" },
    { "foreground": "color.status.danger.text", "background": "color.background.page", "minLc": 75, "usage": "inline danger text" },
    { "foreground": "color.status.danger.text", "background": "color.status.danger.background", "minLc": 60, "usage": "danger alert text" },
    { "foreground": "color.text.body", "background": "color.background.inset", "minLc": 75, "usage": "code text on inset (syntax default)" },
    { "foreground": "color.text.muted", "background": "color.background.inset", "minLc": 60, "usage": "syntax comment on inset" },
    { "foreground": "color.text.link", "background": "color.background.inset", "minLc": 60, "usage": "syntax title/function on inset" },
    { "foreground": "color.status.success.text", "background": "color.background.inset", "minLc": 60, "usage": "syntax string on inset" },
    { "foreground": "color.status.warning.text", "background": "color.background.inset", "minLc": 60, "usage": "syntax number on inset" },
    { "foreground": "color.status.danger.text", "background": "color.background.inset", "minLc": 60, "usage": "syntax keyword on inset" },
    { "foreground": "annotation.selection-bar-text", "background": "annotation.selection-bar-surface", "minLc": 75, "usage": "annotation selection action bar label" },
    { "foreground": "tag.text", "background": "tag.background", "minLc": 60, "usage": "tag label" },
    { "foreground": "callout.tip.border", "background": "color.background.page", "minLc": 45, "usage": "callout tip border (non-text)" },
    { "foreground": "callout.warning.border", "background": "color.background.page", "minLc": 45, "usage": "callout warning border (non-text)" },
    { "foreground": "callout.caution.border", "background": "color.background.page", "minLc": 45, "usage": "callout caution border (non-text)" },
    { "foreground": "callout.important.border", "background": "color.background.page", "minLc": 45, "usage": "callout important border (non-text)" }
  ]
}
