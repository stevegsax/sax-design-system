{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "button": {
    "$type": "color",
    "primary": {
      "background": { "$value": "{color.accent.default}" },
      "background-hover": { "$value": "{color.accent.hover}" },
      "background-active": { "$value": "{color.accent.active}" },
      "text": { "$value": "{color.text.on-accent}" }
    },
    "secondary": {
      "background": { "$value": "{color.background.surface}" },
      "border": { "$value": "{color.border.strong}" },
      "text": { "$value": "{color.text.link}" }
    },
    "disabled": {
      "$description": "Disabled controls are exempt from the APCA gates by recorded decision (decisions/2026-07-19-disabled-state.md).",
      "background": { "$value": "{color.background.disabled}" },
      "text": { "$value": "{color.text.disabled}" }
    }
  },
  "card": {
    "$type": "color",
    "background": { "$value": "{color.background.surface}" },
    "border": { "$value": "{color.border.default}" }
  },
  "input": {
    "$type": "color",
    "background": { "$value": "{color.background.surface}" },
    "text": { "$value": "{color.text.body}" },
    "placeholder": { "$value": "{color.text.muted}" },
    "border": { "$value": "{color.border.strong}" },
    "border-focus": { "$value": "{color.border.focus}" },
    "disabled": {
      "$description": "Disabled controls are exempt from the APCA gates by recorded decision (decisions/2026-07-19-disabled-state.md).",
      "background": { "$value": "{color.background.disabled}" },
      "text": { "$value": "{color.text.disabled}" },
      "border": { "$value": "{color.border.disabled}" }
    }
  },
  "link": {
    "$type": "color",
    "text": { "$value": "{color.text.link}" },
    "text-hover": { "$value": "{color.accent.active}" }
  },
  "annotation": {
    "$type": "color",
    "$description": "Document-annotation marks for document-viewing application UI. These sit on the rendered page, which is theme-independent, so each references a mode-agnostic marker ramp and stays identical in light and dark; the consuming app applies its own translucency/blend.",
    "highlight": { "$value": "{color.highlight.90}" },
    "selected": { "$value": "{color.marker.70}" },
    "selection-bar-surface": { "$value": "{color.neutral.20}" },
    "selection-bar-text": { "$value": "{color.neutral.98}" }
  },
  "tag": {
    "$type": "color",
    "background": { "$value": "{color.accent.subtle}" },
    "text": { "$value": "{color.text.link}" }
  },
  "callout": {
    "$type": "color",
    "$description": "Authored admonitions in static documentation (decisions/2026-07-24-callout-pattern.md). Uniform inset fill; only border and title ink vary per variant.",
    "background": { "$value": "{color.background.inset}" },
    "note": {
      "border": { "$value": "{color.border.default}" },
      "title": { "$value": "{color.text.heading}" }
    },
    "tip": {
      "border": { "$value": "{color.status.success.text}" },
      "title": { "$value": "{color.status.success.text}" }
    },
    "important": {
      "border": { "$value": "{color.accent.default}" },
      "title": { "$value": "{color.text.link}" }
    },
    "warning": {
      "border": { "$value": "{color.status.warning.text}" },
      "title": { "$value": "{color.status.warning.text}" }
    },
    "caution": {
      "border": { "$value": "{color.status.danger.text}" },
      "title": { "$value": "{color.status.danger.text}" }
    }
  }
}
