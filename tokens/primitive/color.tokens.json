{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "neutral": {
      "$description": "Near-achromatic tonal ramp with a faint cool tint (OKLCH hue 250, chroma 0.006). Step number = OKLCH lightness x 100.",
      "0": { "$value": { "colorSpace": "oklch", "components": [0, 0, "none"], "alpha": 1, "hex": "#000000" } },
      "5": { "$value": { "colorSpace": "oklch", "components": [0.05, 0.006, 250], "alpha": 1, "hex": "#000001" } },
      "10": { "$value": { "colorSpace": "oklch", "components": [0.1, 0.006, 250], "alpha": 1, "hex": "#020305" } },
      "15": { "$value": { "colorSpace": "oklch", "components": [0.15, 0.006, 250], "alpha": 1, "hex": "#090b0e" } },
      "20": { "$value": { "colorSpace": "oklch", "components": [0.2, 0.006, 250], "alpha": 1, "hex": "#141619" } },
      "30": { "$value": { "colorSpace": "oklch", "components": [0.3, 0.006, 250], "alpha": 1, "hex": "#2c2e31" } },
      "40": { "$value": { "colorSpace": "oklch", "components": [0.4, 0.006, 250], "alpha": 1, "hex": "#45484b" } },
      "50": { "$value": { "colorSpace": "oklch", "components": [0.5, 0.006, 250], "alpha": 1, "hex": "#616467" } },
      "60": { "$value": { "colorSpace": "oklch", "components": [0.6, 0.006, 250], "alpha": 1, "hex": "#7e8084" } },
      "70": { "$value": { "colorSpace": "oklch", "components": [0.7, 0.006, 250], "alpha": 1, "hex": "#9c9fa2" } },
      "80": { "$value": { "colorSpace": "oklch", "components": [0.8, 0.006, 250], "alpha": 1, "hex": "#bbbec1" } },
      "90": { "$value": { "colorSpace": "oklch", "components": [0.9, 0.006, 250], "alpha": 1, "hex": "#dbdee2" } },
      "95": { "$value": { "colorSpace": "oklch", "components": [0.95, 0.006, 250], "alpha": 1, "hex": "#ebeff2" } },
      "98": { "$value": { "colorSpace": "oklch", "components": [0.98, 0.006, 250], "alpha": 1, "hex": "#f5f9fc" } },
      "100": { "$value": { "colorSpace": "oklch", "components": [1, 0, "none"], "alpha": 1, "hex": "#ffffff" } }
    },
    "brand": {
      "$description": "Brand tonal ramp (OKLCH hue 250). Chroma is gamut-proportional: min(0.17, 0.85 x sRGB gamut maximum at each lightness). Step number = OKLCH lightness x 100.",
      "10": { "$value": { "colorSpace": "oklch", "components": [0.1, 0.0241, 250], "alpha": 1, "hex": "#00040a" } },
      "15": { "$value": { "colorSpace": "oklch", "components": [0.15, 0.0361, 250], "alpha": 1, "hex": "#010c1a" } },
      "20": { "$value": { "colorSpace": "oklch", "components": [0.2, 0.0481, 250], "alpha": 1, "hex": "#03172b" } },
      "30": { "$value": { "colorSpace": "oklch", "components": [0.3, 0.0722, 250], "alpha": 1, "hex": "#0b2f50" } },
      "40": { "$value": { "colorSpace": "oklch", "components": [0.4, 0.0962, 250], "alpha": 1, "hex": "#164a79" } },
      "50": { "$value": { "colorSpace": "oklch", "components": [0.5, 0.1203, 250], "alpha": 1, "hex": "#2166a4" } },
      "60": { "$value": { "colorSpace": "oklch", "components": [0.6, 0.1444, 250], "alpha": 1, "hex": "#2d84d2" } },
      "70": { "$value": { "colorSpace": "oklch", "components": [0.7, 0.139, 250], "alpha": 1, "hex": "#54a3f1" } },
      "80": { "$value": { "colorSpace": "oklch", "components": [0.8, 0.0892, 250], "alpha": 1, "hex": "#92c3f5" } },
      "90": { "$value": { "colorSpace": "oklch", "components": [0.9, 0.0429, 250], "alpha": 1, "hex": "#c9e1fa" } },
      "95": { "$value": { "colorSpace": "oklch", "components": [0.95, 0.021, 250], "alpha": 1, "hex": "#e4f0fc" } },
      "98": { "$value": { "colorSpace": "oklch", "components": [0.98, 0.0083, 250], "alpha": 1, "hex": "#f4f9fe" } }
    }
  }
}
